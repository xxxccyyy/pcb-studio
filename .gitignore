# 临时产物（探针/对拍副本/CPU 剖析——深度优化与审计的中间产物，报告已固化结论）
.scratch/
# Python
__pycache__/
*.pyc
# 剖析与日志
*.cpuprofile
*.log
# 依赖（运行时零依赖；node_modules 仅有构建期 devDependencies：esbuild/postject/playwright）
node_modules/
# exe 打包产物（npm run exe 重新生成）
dist/
# AI 控制桥会话目录（运行时产物：设计/布线文件 + bridge.json）
pcb-session/
# Bridge discovery credentials in custom session directories
bridge.json
# Local configuration and editor/OS files
.env
.env.*
!.env.example
.vscode/
.idea/
.DS_Store
Thumbs.db

# Fable 复刻工作产物（迭代/备份不入库，只收终态与 sprint 存档）
projects/ext-fable-*/design-sprint-v*.json
projects/ext-fable-*/manual-plan*.json
projects/ext-fable-*.json.bak-*
projects/ext-fable-*/*.bak-*
